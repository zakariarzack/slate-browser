{
  "name": "slate",
  "version": "1.0.0",
  "description": "Slate Browser — The fluid, privacy-first workspace browser for macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:fast": "vite build && electron-builder --mac dir --publish never && pkill -f \"Slate.app/Contents/MacOS/Slate\" || true && rm -rf /Applications/Slate.app && cp -R release/mac-arm64/Slate.app /Applications/ && open /Applications/Slate.app",
    "dist:mac": "vite build && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "com.slate.browser",
    "productName": "Slate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-context-menu": "^5.1.0",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "productName": "Slate"
}
